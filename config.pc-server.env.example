# 3ALORA OPS V18 - PC SERVER / DOMAIN PROFILE
# Copy this file to: C:\ProgramData\3ALORA_OPS\config.env

NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://ops.example.com
TRUST_PROXY=1
FORCE_HTTPS=1
COOKIE_SECURE=1
SESSION_HOURS=12
GLOBAL_RATE_LIMIT_PER_MIN=600
MAX_SESSIONS_PER_USER=8

# Requirement: first 10 wrong attempts still allow another login attempt.
# The 11th consecutive wrong attempt activates the 5-minute lock.
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=5

# Data is intentionally outside the source/release directory.
PERSIST_ROOT=C:/ProgramData/3ALORA_OPS
DB_PATH=C:/ProgramData/3ALORA_OPS/3alora.sqlite
BACKUP_DIR=C:/ProgramData/3ALORA_OPS/backups
LOG_DIR=C:/ProgramData/3ALORA_OPS/logs
BACKUP_KEEP=30
BACKUP_INTERVAL_HOURS=24

# Strongly recommended: another physical disk / NAS / OneDrive-synced folder.
# Example: D:/3ALORA_OFFSITE_BACKUP
OFFSITE_BACKUP_DIR=
OFFSITE_BACKUP_KEEP=60

# Generate/store this privately in config.env. Do not put secrets into release ZIP.
# BACKUP_ENCRYPTION_KEY=your-long-private-passphrase

# Required for a NEW database when running as a service. Existing users are preserved.
ALORA_ADMIN_PASSWORD=

ALLOW_PUBLIC_SHEET_IMPORT=0
SEED_DEMO_DATA=0
EVIDENCE_MAX_FILE_BYTES=3000000
EVIDENCE_MAX_FILES_PER_ORDER=30
EVIDENCE_MAX_BYTES_PER_ORDER=75000000
LOG_MAX_BYTES=10000000
LOG_KEEP=5

# V18: only these proxy socket peers may supply forwarded headers.
# Docker Compose: the fixed Caddy address is 172.30.48.2.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Optional PWA push. Generate once and keep private key outside source.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
