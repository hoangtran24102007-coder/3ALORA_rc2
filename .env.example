# Copy to C:/ProgramData/3ALORA_OPS/config.env ONLY if it does not exist.
# For an upgrade, keep the actual DB_PATH/config used by the previous server.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://ops.3alora.io.vn
TRUST_PROXY=1
TRUSTED_PROXY_IPS=127.0.0.1,::1
FORCE_HTTPS=1
COOKIE_SECURE=1
PERSIST_ROOT=C:/ProgramData/3ALORA_OPS
DB_PATH=C:/ProgramData/3ALORA_OPS/3alora.sqlite
EVIDENCE_DIR=C:/ProgramData/3ALORA_OPS/evidence
BACKUP_DIR=C:/ProgramData/3ALORA_OPS/backups
LOG_DIR=C:/ProgramData/3ALORA_OPS/logs
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=30
SEED_DEMO_DATA=0
ALORA_TEAM_GUARD=1
ALLOW_PUBLIC_SHEET_IMPORT=0
# Only needed for a deliberately NEW installation, not an upgrade.
# ALORA_ADMIN_PASSWORD=
# Set these with your own generated VAPID key pair to enable phone Web Push.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# Optional backup encryption; preserve the current key across upgrades.
# BACKUP_ENCRYPTION_KEY=
# OFFSITE_BACKUP_DIR=D:/3ALORA_BACKUPS

# Install Python for ALL USERS before using the Windows LocalService.
# PYTHON=C:/Program Files/Python313/python.exe
