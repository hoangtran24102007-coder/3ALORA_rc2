# 3 ALORA OPS V18 WEB/PWA
# Copy thành .env; đặt DOMAIN, mật khẩu bootstrap và khóa backup riêng.
DOMAIN=ops.example.com

# Ứng dụng
NODE_ENV=production
SESSION_HOURS=12
GLOBAL_RATE_LIMIT_PER_MIN=300
MAX_SESSIONS_PER_USER=8
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=5
BACKUP_KEEP=30
BACKUP_INTERVAL_HOURS=24

# Bắt buộc khi DB mới chạy bằng dịch vụ/Docker; đổi sau lần đăng nhập đầu.
ALORA_ADMIN_PASSWORD=

# V13 backup hardening
BACKUP_ENCRYPTION_KEY=
# OFFSITE_BACKUP_DIR=/data/offsite-backups
ALLOW_PUBLIC_SHEET_IMPORT=0
SEED_DEMO_DATA=0

# Evidence limits
EVIDENCE_MAX_FILE_BYTES=3000000
EVIDENCE_MAX_FILES_PER_ORDER=30
EVIDENCE_MAX_BYTES_PER_ORDER=75000000
LOG_MAX_BYTES=10000000
LOG_KEEP=5

# V18: only these proxy socket peers may supply forwarded headers.
# Docker Compose: the fixed Caddy address is 172.30.48.2.
TRUSTED_PROXY_IPS=172.30.48.2
# Optional PWA push. Generate once and keep private key outside source.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
